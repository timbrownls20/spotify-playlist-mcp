# Copy to .env and fill in. .env is git-ignored; this template is not.

# Spotify app credentials — https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Must match a redirect URI registered on the app exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: playlist used when a tool is called without playlist_id.
# SPOTIFY_DEFAULT_PLAYLIST=

# Optional: override the token cache path (default .spotify-token.json here).
# SPOTIFY_TOKEN_FILE=

# Optional: pnpm auth prints the consent URL instead of opening a browser.
# SPOTIFY_NO_BROWSER=1
